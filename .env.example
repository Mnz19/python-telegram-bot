# Copy this file to .env and fill in the values.
# Local dev (DJANGO_ENV=dev) only needs TELEGRAM_BOT_TOKEN and RAPIDAPI_KEY
# to work — it uses SQLite and an in-process cache automatically.

# dev | prod | test  (defaults to "dev" if unset)
DJANGO_ENV=dev

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-in-production

# Only read in prod.py — comma-separated list of allowed hostnames
DJANGO_ALLOWED_HOSTS=

# Only read in prod.py ("true"/"false")
DJANGO_DEBUG=false

DJANGO_TIME_ZONE=America/Belem

# --- Telegram ---
# Get one from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# --- Flight price provider ---
# "skyscanner" (default) or "amadeus"
FLIGHT_PROVIDER=skyscanner

# --- Sky Scrapper on RapidAPI (https://rapidapi.com/apiheya/api/sky-scrapper) ---
# Create a free RapidAPI account (Google/GitHub login, instant), subscribe to
# Sky Scrapper's free plan, and copy the key shown under "X-RapidAPI-Key".
RAPIDAPI_KEY=

# --- Amadeus for Developers (https://developers.amadeus.com) ---
# Only used if FLIGHT_PROVIDER=amadeus. Free "test" tier credentials work
# against AMADEUS_BASE_URL below, but signup requires manual account review.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# --- Celery / Redis (only used in prod / docker-compose) ---
REDIS_URL=redis://redis:6379/0

# --- Postgres (only used in prod, via DATABASE_URL) ---
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/flightbot

# Minutes between automatic price checks (seeded into django-celery-beat on
# first migrate; adjustable afterwards from /admin without a redeploy)
PRICE_CHECK_INTERVAL_MINUTES=60

# Default origin airport suggested to users in /novaalerta
DEFAULT_ORIGIN_IATA=BEL
